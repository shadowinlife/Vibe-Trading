# =============================================================================
# .env.example — OpenCode Web Server 环境变量
# 复制为 .env 并填入实际值
# =============================================================================

# --- 必须 ---
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
OPENCODE_SERVER_PASSWORD=your-server-password

# --- LLM 出口代理 (v3.4.0-mymain, Phase 9a; 可选) ---
# 设置 LLM_BASE_URL 后 provider.alibaba-cn 走 RM 内嵌 LLM 代理,
# 真实 DashScope key 不进沙箱 (由 RM 上游注入), DASHSCOPE_API_KEY 可留空。
# 两者均不设置 = 直连模式 (渲染输出与 v3.3.0 字节等价)。
# LLM_BASE_URL=http://rm-host:port/llm/v1
# LLM_API_KEY=your-sandbox-proxy-credential

# --- ClickHouse (数据仓库) ---
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=ashare
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
# 可选: VT ch_* 语义层工具 (ch_list_tables/ch_describe_table/ch_query) 的 llm_role 只读用户
# CLICKHOUSE_LLM_USER=llm_role
# 可选: llm_role 只读用户密码; 不配置时这 3 个 ch_* 工具不可用, 其余 VT 工具不受影响
# CLICKHOUSE_LLM_PASSWORD=your-llm-role-password

# --- 通知 (可选) ---
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token
SMTP_HOST=smtp.163.com
SMTP_AUTH_CODE=your-smtp-auth-code

# --- LangChain / Vibe-Trading ---
LANGCHAIN_PROVIDER=dashscope
LANGCHAIN_MODEL_NAME=qwen3.8-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LANGCHAIN_TEMPERATURE=0.3

# --- Tushare (数据同步用, 可选) ---
# TUSHARE_TOKEN=your-tushare-token

# --- Twitter (数据采集用, 可选) ---
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=
# TWITTER_BEARER_TOKEN=

# --- question 工具 (可选) ---
# 启用 serve/web 面的 question 工具（结构化澄清卡片）；值由部署注入，此处不填。
OPENCODE_ENABLE_QUESTION_TOOL=
