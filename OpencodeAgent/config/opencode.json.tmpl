{
  "$schema": "https://opencode.ai/config.json",
  "model": "alibaba-cn/deepseek-v4.1-flash-1017",
  "provider": {
    "alibaba-cn": {
      "models": {
        "deepseek-v4.1-flash-1017": {
          "attachment": true,
          "limit": {
            "context": 1000000,
            "input": 500000,
            "output": 131072
          },
          "name": "DeepSeek V4.1 Flash 1017",
          "options": {
            "enable_thinking": true,
            "reasoning_effort": "high"
          },
          "reasoning": true,
          "tool_call": true
        }
      }{%- if LLM_BASE_URL %},
      "options": {
        "baseURL": "{{ LLM_BASE_URL }}",
        "apiKey": "{{ LLM_API_KEY }}",
        "headers": {
          "x-sandbox-id": "{{ SANDBOX_ID }}"
        }
      }{%- endif %}
    }
  },
  "tool_output": {
    "max_bytes": 262144,
    "max_lines": 8000
  },
  "mcp": {
    "vibe-trading": {
      "type": "local",
      "command": [
        "/opt/venv/bin/python",
        "/opt/vibe-trading/agent/mcp_server.py"
      ],
      "timeout": 600000,
      "environment": {
        "CLICKHOUSE_HOST": "{{ CLICKHOUSE_HOST }}",
        "CLICKHOUSE_PORT": "{{ CLICKHOUSE_PORT }}",
        "CLICKHOUSE_USER": "{{ CLICKHOUSE_USER }}",
        "CLICKHOUSE_PASSWORD": "{{ CLICKHOUSE_PASSWORD }}",
        "CLICKHOUSE_DATABASE": "{{ CLICKHOUSE_DATABASE }}",
        "CLICKHOUSE_LLM_USER": "{{ CLICKHOUSE_LLM_USER }}",
        "CLICKHOUSE_LLM_PASSWORD": "{{ CLICKHOUSE_LLM_PASSWORD }}",
        "VT_MEMORY": "full",
        "VT_MEMORY_MCP_TOOLS": "1",
        "VT_MEMORY_BASE_DIR": "/workspace/.vt-memory"
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "question": "allow"
      }
    },
    "plan": {
      "permission": {
        "question": "allow"
      }
    },
    "explore": {
      "permission": {
        "vibe-trading_*": "deny"
      }
    },
    "multimodal-looker": {
      "permission": {
        "vibe-trading_*": "deny"
      }
    }
  },
  "plugin": [
    "oh-my-openagent@5.1.35"
  ]
}
