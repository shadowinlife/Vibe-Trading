{
  "$comment": "DRAFT SKELETON — TODO-G1: pending RM written approval of pt-v1.1 (PAPER_TRADING_ENGINE_AMENDMENT_PT_V1.1.md). First tool-contract schema in this repo (VD-13 landing spot; the root schema/ tree otherwise holds ClickHouse DDL only). Field set per AMENDMENT §2.2/§2.3 and AM-14 vocabularies; nothing here is hard-frozen before G1. Two named schemas live under 'schemas': 'result' (success out-param document) and 'error_envelope' (in-band error, AM-5). Both stay within the keyword subset the dependency-free validator in agent/src/tools/paper_trade/schema.py implements (type/const/enum/required/properties/items/additionalProperties), so the file is a standard draft-2020-12 document that the real jsonschema library can also consume.",
  "contract": "paper_trade_step",
  "version": "pt-v1.1",
  "status": "draft-pending-g1",
  "schemas": {
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://vibe-trading.local/schemas/tool_contracts/paper_trade_step-v1.1/result.json",
      "title": "paper_trade_step success result (pt-v1.1 DRAFT)",
      "type": "object",
      "required": [
        "schema_version",
        "tool",
        "account_id",
        "market",
        "range",
        "received_state_hash",
        "effective_fee_model",
        "fills",
        "rejected_orders",
        "end_state",
        "nav_series",
        "skipped_days",
        "warnings",
        "data_provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "pt-v1.1",
          "$comment": "TODO-G1: const value frozen only on RM approval of pt-v1.1"
        },
        "tool": { "type": "string", "const": "paper_trade_step" },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "$comment": "verbatim echo of the input (R4)"
        },
        "market": { "type": "string", "enum": ["cn_a", "hk", "us"] },
        "range": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        "received_state_hash": {
          "type": "string",
          "$comment": "sha256(JCS(non-order inputs)) — AM-4/R7; 64 lowercase hex"
        },
        "effective_fee_model": {
          "type": "object",
          "$comment": "TODO-G1: per-market fee key names — cn_a keys follow AMENDMENT §2.2 example; hk/us key names are draft (state_hash.py _DEFAULT_FEE_MODELS)"
        },
        "fills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["trade_date", "symbol", "side", "qty", "price", "fee", "reason"],
            "additionalProperties": false,
            "properties": {
              "trade_date": { "type": "string" },
              "symbol": { "type": "string" },
              "side": { "type": "string", "enum": ["buy", "sell"] },
              "qty": { "type": "number" },
              "price": { "type": "number" },
              "fee": { "type": "number" },
              "reason": {
                "type": "string",
                "$comment": "VD-15: orders mode = empty string; strategy_path mode = strategy reason text truncated to <=200 chars (UTF-8 safe)"
              }
            }
          }
        },
        "rejected_orders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["trade_date", "symbol", "side", "qty", "reason_code", "detail"],
            "additionalProperties": false,
            "properties": {
              "trade_date": { "type": "string" },
              "symbol": { "type": "string" },
              "side": { "type": "string", "enum": ["buy", "sell"] },
              "qty": { "type": "number" },
              "reason_code": {
                "type": "string",
                "enum": [
                  "insufficient_cash",
                  "insufficient_position",
                  "t_plus_1",
                  "limit_up",
                  "limit_down",
                  "suspended",
                  "lot_size",
                  "non_trading_day",
                  "unknown_symbol",
                  "corporate_action_unresolved",
                  "limit_not_marketable"
                ],
                "$comment": "AM-14 closed vocabulary (11) — any change = major schema bump"
              },
              "detail": { "type": "string" }
            }
          }
        },
        "end_state": {
          "type": "object",
          "required": ["cash", "positions"],
          "additionalProperties": false,
          "properties": {
            "cash": { "type": "number" },
            "positions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["symbol", "qty", "avg_cost"],
                "additionalProperties": false,
                "properties": {
                  "symbol": { "type": "string" },
                  "qty": { "type": "number" },
                  "avg_cost": { "type": "number" }
                }
              }
            }
          }
        },
        "nav_series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "nav", "cash", "position_value"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string" },
              "nav": { "type": "number" },
              "cash": { "type": "number" },
              "position_value": { "type": "number" }
            }
          }
        },
        "skipped_days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "reason"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string" },
              "reason": {
                "type": "string",
                "enum": ["non_trading_day", "market_closed_inferred"],
                "$comment": "AM-14 closed vocabulary (2): non_trading_day = cn_a only (CH calendar truth); market_closed_inferred = hk/us only, always accompanied by a warning (AM-6)"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "$comment": "deterministic English strings, never contain timestamps (VD-7 / R1 hard semantics 1)"
        },
        "data_provenance": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {
              "type": "string",
              "$comment": "AM-9 merged-frame form for cn_a, e.g. 'clickhouse+tencent(merged)'"
            },
            "ch_as_of": { "type": "string" },
            "network_as_of": { "type": "string" },
            "bars_as_of": { "type": "string" },
            "corporate_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["symbol", "date", "ratio"],
                "properties": {
                  "symbol": { "type": "string" },
                  "date": { "type": "string" },
                  "ratio": { "type": "string" },
                  "detected": { "type": "string" }
                }
              }
            }
          },
          "$comment": "TODO-G1: additionalProperties intentionally open — VD-11 limit/ST/suspension path provenance (table vs heuristic) and AM-9 merge-state fields extend this object; the extension set is frozen at G1"
        }
      }
    },
    "error_envelope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://vibe-trading.local/schemas/tool_contracts/paper_trade_step-v1.1/error_envelope.json",
      "title": "paper_trade_step in-band error envelope (pt-v1.1 DRAFT, AM-5)",
      "type": "object",
      "required": ["status", "code", "account_id", "market", "range", "message"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": {
          "type": "string",
          "enum": ["PAPER_DATA_NOT_READY", "INVALID_REQUEST"],
          "$comment": "AM-14 closed vocabulary (2 + transport reserved): PAPER_DATA_NOT_READY = retryable (RM 30min x 3); INVALID_REQUEST = non-retryable. Transport-level MCP errors are reserved for engine-internal faults."
        },
        "account_id": {
          "type": "string",
          "$comment": "verbatim echo even on the error path (AM-4-4/AM-5)"
        },
        "market": { "type": "string", "enum": ["cn_a", "hk", "us"] },
        "range": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        "received_state_hash": {
          "type": "string",
          "$comment": "present when the received account_state was parseable (AM-4-4)"
        },
        "message": { "type": "string" }
      }
    }
  }
}
